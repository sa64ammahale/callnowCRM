# Secrets / local config (keep .env.example committed, never .env)
.env
.env.*
!.env.example
*.local
*copy*
*backup*
*.bak
*.tmp
*.cache

# Logs & temp error logs
*.log
error_log

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~
.kilo/
memory/
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Root testing screenshots / debug dumps (assets/ stays tracked)
/*.png
/*.jpg
/*.jpeg
archive/

# Uploaded user files (git-tracked via .gitkeep only)
uploads/*
!uploads/.htaccess
!uploads/.gitkeep
!uploads/logo/
!uploads/logo/.gitkeep
!uploads/profile_photos/
!uploads/profile_photos/.gitkeep
!uploads/tenants/
!uploads/tenants/.gitkeep

# Hosting control files
.user.ini
