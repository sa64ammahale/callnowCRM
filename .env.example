# ─────────────────────────────────────────────────────────────
# CallNow CRM — environment configuration (copy to .env and fill in)
# Hostinger: you can also set these as real environment variables,
# or just place a .env file in the project root.
# ─────────────────────────────────────────────────────────────

# Database (use the credentials from Hostinger → Databases → PHPMyAdmin)
DB_SERVERNAME=localhost
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Set to 1 to show PHP errors (NEVER on production)
APP_DEBUG=0

# One-time setup key required to open CallNowSignUp.php for initial admin
# provisioning. Leave empty to keep registration fully disabled.
SETUP_KEY=
