# CallNow CRM Environment Configuration
# Copy this file to .env and fill in your actual values.
# On Hostinger, set these via hPanel → Advanced → Environment Variables instead.

# ── Database ──────────────────────────────────────────────
DB_SERVERNAME=localhost
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=callnow_incredit

# ── Application ──────────────────────────────────────────
APP_DEBUG=0
APP_ENV=production

# ── Mail (optional, for password reset / notifications) ──
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=your_email@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME=CallNow CRM
SMTP_ENCRYPTION=ssl
