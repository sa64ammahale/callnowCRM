# CallNow CRM Environment Configuration
# Copy this file to .env and fill in your actual values.
# On Hostinger, you can use .env in the project root OR set these via hPanel → Advanced → Environment Variables.

# ── Multi-Tenant Master Database ─────────────────────────────
# Central database containing the company routing registry (companies catalog)
# Example for Hostinger: u661890306_COMMON
MASTER_DB_NAME=callnow_master

# Master catalog table name (default: callnow_telecalling_companys)
MASTER_COMPANIES_TABLE=callnow_telecalling_companys

# Default fallback company code if none entered or found in session/cookies
DEFAULT_COMPANY_CODE=incredit

# ── Database Connection ──────────────────────────────────────
# Default credentials used for MySQL connection and default tenant DB
DB_SERVERNAME=localhost
DB_PORT=3306
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# Default tenant database name (e.g. u661890306_incredit or callnow_incredit)
DB_NAME=callnow_incredit

# ── Application Configuration ────────────────────────────────
# Full public URL to your CRM root (without trailing slash)
APP_URL=https://crm.yourdomain.com/callnowCRM

# Set APP_DEBUG=1 only during troubleshooting; 0 for production
APP_DEBUG=0
APP_ENV=production

# One-time setup key for initial administrator provisioning (optional)
SETUP_KEY=callnow2026

# ── Mail Configuration (Password reset & notifications) ──────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=your_email@yourdomain.com
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=no-reply@yourdomain.com
SMTP_FROM_NAME="CallNow CRM"
SMTP_ENCRYPTION=ssl
